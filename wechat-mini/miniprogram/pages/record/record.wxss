/* 「业务进度查询」页专属样式。公共部分在 app.wxss 里。 */

.support-card {
  background: #1a1e25;
  border-color: #2b313a;
}

.support-btn {
  display: block;
  width: 100%;
  margin-top: 22rpx;
}

.no-input {
  height: 92rpx;
  background: #11141a;
  border: 1rpx solid #2f3542;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: #e9ecf1;
}

.no-ph {
  color: #6b7280;
  font-size: 28rpx;
  letter-spacing: 0;
}

/* 查不到 / 维护中 */
.err {
  border-color: #4a3a2a;
  background: #1d1a15;
}

.err-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #fbbf24;
}

/* 结果卡 */
.result-no {
  font-size: 28rpx;
  color: #dfe4ec;
}

.badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(198, 242, 78, 0.14);
  border: 1rpx solid #4a5a2a;
  font-size: 22rpx;
  color: #c6f24e;
}

.result-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.result-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b94a3;
}

.progress-text {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #cbd2dc;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #222731;
}

.result-row.column {
  flex-direction: column;
  align-items: flex-start;
}

.value {
  font-size: 25rpx;
  color: #dfe4ec;
  max-width: 60%;
  text-align: right;
}

.value.note {
  margin-top: 8rpx;
  max-width: 100%;
  text-align: left;
  line-height: 1.6;
  color: #98a1af;
}

.shot {
  margin-top: 18rpx;
  width: 100%;
  border-radius: 10rpx;
  background: #11141a;
}

.shot-hint {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6b7280;
  text-align: center;
}

/* 历史单号 */
.link {
  font-size: 23rpx;
  color: #8b94a3;
}

.his {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  background: #14171d;
  border: 1rpx solid #222731;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #cbd2dc;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}
