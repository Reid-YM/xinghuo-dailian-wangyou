<view class="page">
  <view class="hero">
    <view class="hero-title">迷彩攻略</view>
    <view class="hero-sub">{{shown.length}} 篇{{updatedText ? ' · ' + updatedText : ''}}</view>
  </view>

  <input
    class="search"
    placeholder="搜攻略：迷彩、设置、兑换码…"
    placeholder-class="search-ph"
    value="{{keyword}}"
    bindinput="onSearch"
    confirm-type="search"
  />

  <view class="loading" wx:if="{{loading}}">正在加载攻略…</view>

  <view class="card err" wx:if="{{error}}">
    <view class="err-text">{{error}}</view>
    <view class="actions">
      <button class="btn ghost" bindtap="onRetry">重新加载</button>
    </view>
  </view>

  <view class="g" wx:for="{{shown}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="onTap">
    <image
      class="g-cover"
      wx:if="{{showImages && item.cover}}"
      src="{{item.cover}}"
      mode="aspectFill"
      lazy-load
    ></image>
    <view class="g-body">
      <view class="g-title">{{item.title}}</view>
      <view class="g-sum" wx:if="{{item.summary}}">{{item.summary}}</view>
      <view class="g-meta">
        <text class="badge" wx:if="{{item.difficulty}}">{{item.difficulty}}</text>
        <text class="g-meta-text" wx:if="{{item.minutes}}">{{item.minutes}} 分钟</text>
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !error && !shown.length}}">
    <view class="empty-title">{{keyword ? '未找到相关攻略' : '暂无攻略内容'}}</view>
    <view class="empty-desc">{{keyword ? '请尝试其他关键词。' : '可稍后刷新查看。'}}</view>
    <button class="btn ghost empty-action" wx:if="{{keyword}}" bindtap="onResetSearch">清除搜索</button>
  </view>

  <view class="card service" wx:if="{{copy}}">
    <view class="service-title">{{copy.cardTitle}}</view>
    <view class="service-desc">{{copy.cardDesc}}</view>
    <button class="service-btn" open-type="contact" session-from="{{sessionFrom}}">{{copy.buttonText}}</button>
  </view>

  <view class="footer">内容来自星火官网攻略库，官网更新后小程序自动同步。</view>
</view>
