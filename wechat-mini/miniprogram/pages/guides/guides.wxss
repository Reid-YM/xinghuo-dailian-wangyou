/* 攻略列表页样式。公共部分在 app.wxss 里。 */

.search {
  height: 84rpx;
  background: #171a21;
  border: 1rpx solid #262b35;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #e9ecf1;
  margin-bottom: 20rpx;
}

.search-ph {
  color: #6b7280;
}



/* 攻略卡 */
.g {
  background: #1a1e25;
  border: 1rpx solid #2b313a;
  border-radius: 12rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.g-cover {
  width: 100%;
  height: 240rpx;
  background: #11141a;
  display: block;
}

.g-body {
  padding: 22rpx 24rpx 24rpx;
}

.g-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.g-sum {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #98a1af;
}

.g-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(198, 242, 78, 0.14);
  border: 1rpx solid #4a5a2a;
  font-size: 21rpx;
  color: #c6f24e;
}

.g-meta-text {
  font-size: 22rpx;
  color: #8b94a3;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #1c2027;
  font-size: 20rpx;
  color: #7c8595;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #6b7280;
}
