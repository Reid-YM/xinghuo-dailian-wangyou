page{min-height:100%;background:#090b0f;color:#f5f7fa;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button{border-radius:16rpx;font-weight:700}button::after{border:0}.page{padding:36rpx 28rpx 56rpx;box-sizing:border-box}.hero{padding:26rpx 8rpx 34rpx}.eyebrow{display:block;color:#f4bd34;font-size:24rpx;font-weight:700;letter-spacing:4rpx}.title{display:block;margin-top:12rpx;font-size:48rpx;line-height:1.18;font-weight:800}.sub{display:block;margin-top:18rpx;color:#aeb7c4;font-size:28rpx;line-height:1.75}.card{margin-bottom:24rpx;padding:30rpx;border:1rpx solid #303743;border-radius:26rpx;background:#121720;box-shadow:0 18rpx 48rpx rgba(0,0,0,.2)}.section-title{display:block;margin-bottom:16rpx;font-size:30rpx;font-weight:800}.section-title-inline{margin-bottom:0}.section-head-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:16rpx}.mini-link{margin:0!important;padding:0 18rpx!important;min-height:56rpx;line-height:56rpx;background:#242b35!important;color:#d8dee7!important;font-size:23rpx!important}.primary{background:#f4bd34!important;color:#15120a!important}.secondary{margin-top:18rpx;background:#242b35!important;color:#f5f7fa!important}.ghost{margin-top:18rpx;background:transparent!important;color:#d8dee7!important;border:1rpx solid #3c4654!important}.code{height:96rpx;padding:0 24rpx;border:1rpx solid #424b58;border-radius:18rpx;background:#0c1118;color:#f4bd34;font-size:44rpx;font-weight:800;letter-spacing:10rpx;text-align:center}.divider{display:flex;align-items:center;justify-content:center;margin:24rpx 0;color:#778291;font-size:24rpx}.status{display:block;margin-top:22rpx;padding:18rpx;border-radius:16rpx;background:#0c1118;color:#aeb7c4;font-size:26rpx;line-height:1.6}.status.ok{color:#9fe0b5}.status.error{color:#ff9b9b}.profile-name{display:block;font-size:34rpx;font-weight:800}.profile-meta{display:block;margin-top:10rpx;color:#9ea8b5;font-size:25rpx;line-height:1.6}.input{height:84rpx;padding:0 22rpx;border:1rpx solid #3c4654;border-radius:16rpx;background:#0c1118;color:#f5f7fa;font-size:28rpx}.payment-item{margin-top:22rpx;padding:22rpx;border:1rpx solid #343d49;border-radius:20rpx;background:#0c1118}.payment-line{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.payment-subject{font-size:28rpx;line-height:1.45;font-weight:700;flex:1}.payment-amount{color:#f4bd34;font-size:32rpx;font-weight:800;white-space:nowrap}.payment-meta{display:block;margin-top:10rpx;color:#929dac;font-size:23rpx;line-height:1.55}.payment-button{margin-top:20rpx!important}.paid-badge{display:inline-block;margin-top:18rpx;padding:8rpx 16rpx;border-radius:999rpx;background:rgba(100,210,140,.14);color:#9fe0b5;font-size:23rpx;font-weight:700}.foot{display:block;padding:16rpx 8rpx;color:#7f8a99;font-size:23rpx;line-height:1.7;text-align:center}
